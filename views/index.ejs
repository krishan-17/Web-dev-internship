<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Register</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="/style.css">
</head>
<body class="bg-gray-50 text-gray-700">

    <!-- HEADER   -->
    <header class="bg-white shadow-sm sticky top-0 z-10">
        <div class="max-w-5xl mx-auto px-6 py-4 flex justify-between items-center">
            <span class="text-lg font-bold text-indigo-600">Registration Form</span>
            <nav class="hidden md:flex gap-6 text-sm font-medium text-gray-500">
                <a href="#about" class="hover:text-indigo-600">About</a>
                <a href="#services" class="hover:text-indigo-600">Services</a>
                <a href="#register" class="hover:text-indigo-600">Register</a>
                <a href="#contact" class="hover:text-indigo-600">Contact</a>
                <a href="/users" class="hover:text-indigo-600">Users</a>
            </nav>
        </div>
    </header>


    <!-- About Section  -->


    <section id="about" class="py-14 px-6 bg-white">
        <div class="max-w-4xl mx-auto text-center">
            <h2 class="text-2xl font-bold text-gray-800 mb-3">About</h2>
            <p class="text-gray-500 text-sm max-w-xl mx-auto mb-8">
                It is a simple user registration system built with Node.js, EJS, and Tailwind CSS. It validates your data on both client and server side.
            </p>
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-5">
                <div class="card border rounded-xl p-5">
                    <p class="text-2xl mb-2">🛡️</p>
                    <p class="font-semibold text-sm text-gray-800">Server Validation</p>
                    <p class="text-gray-400 text-xs mt-1">Validate user on the backend</p>
                </div>
                <div class="card border rounded-xl p-5">
                    <p class="text-2xl mb-2">⚡</p>
                    <p class="font-semibold text-sm text-gray-800">Client Validation</p>
                    <p class="text-gray-400 text-xs mt-1">Instant error feedback on form</p>
                </div>
                <div class="card border rounded-xl p-5">
                    <p class="text-2xl mb-2">📱</p>
                    <p class="font-semibold text-sm text-gray-800">Responsive</p>
                    <p class="text-gray-400 text-xs mt-1">Works on all screen sizes</p>
                </div>
            </div>
        </div>
    </section>

    <!-- SERVICES -->
    <section id="services" class="py-14 px-6 bg-gray-50">
        <div class="max-w-4xl mx-auto text-center">
            <h2 class="text-2xl font-bold text-gray-800 mb-3">Services</h2>
            <p class="text-gray-500 text-sm max-w-xl mx-auto mb-8">
                What this app provides in simple terms.
            </p>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-5 text-left">
                <div class="card bg-white border rounded-xl p-5">
                    <p class="font-semibold text-gray-800 mb-1">📝 User Registration</p>
                    <p class="text-gray-400 text-sm">Fill the form below to register yourself with username, email, age and password.</p>
                </div>
                <div class="card bg-white border rounded-xl p-5">
                    <p class="font-semibold text-gray-800 mb-1">📋 View Registered Users</p>
                    <p class="text-gray-400 text-sm">See all users who have registered in this session in a clean table.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- REGISTER FORM -->
    <section id="register" class="py-14 px-6 bg-white">
        <div class="max-w-md mx-auto">
            <h2 class="text-2xl font-bold text-gray-800 text-center mb-1">Register</h2>
            <p class="text-center text-gray-400 text-sm mb-6">Fill in your details below</p>

            <% if (typeof success !== 'undefined' && success) { %>
            <div class="bg-green-50 border border-green-200 rounded-xl p-4 mb-5 text-sm text-green-700 text-center">
                ✅ <strong><%= registered.username %></strong> registered successfully!
                <a href="/users" class="underline ml-1 hover:text-green-900">View Users</a>
            </div>
            <% } %>

            <form action="/#register" method="POST">
                <div class="mb-4">
                    <label class="block text-sm font-medium text-gray-600 mb-1">Username</label>
                    <input type="text" name="username" value="<%= old.username || '' %>"
                           placeholder="e.g. john_doe"
                           class="w-full px-4 py-2.5 border border-gray-200 rounded-lg text-sm bg-gray-50 text-gray-800 transition-all">
                    <% if (errors.username) { %>
                    <p class="text-red-500 text-xs mt-1"><%= errors.username %></p>
                    <% } %>
                </div>

                <div class="mb-4">
                    <label class="block text-sm font-medium text-gray-600 mb-1">Email</label>
                    <input type="email" name="email" value="<%= old.email || '' %>"
                           placeholder="you@example.com"
                           class="w-full px-4 py-2.5 border border-gray-200 rounded-lg text-sm bg-gray-50 text-gray-800 transition-all">
                    <% if (errors.email) { %>
                    <p class="text-red-500 text-xs mt-1"><%= errors.email %></p>
                    <% } %>
                </div>

                <div class="mb-4">
                    <label class="block text-sm font-medium text-gray-600 mb-1">Age</label>
                    <input type="number" name="age" value="<%= old.age || '' %>"
                           placeholder="13 – 100"
                           class="w-full px-4 py-2.5 border border-gray-200 rounded-lg text-sm bg-gray-50 text-gray-800 transition-all">
                    <% if (errors.age) { %>
                    <p class="text-red-500 text-xs mt-1"><%= errors.age %></p>
                    <% } %>
                </div>

                <div class="mb-4">
                    <label class="block text-sm font-medium text-gray-600 mb-1">Password</label>
                    <input type="password" name="password"
                           placeholder="Min. 6 characters"
                           class="w-full px-4 py-2.5 border border-gray-200 rounded-lg text-sm bg-gray-50 text-gray-800 transition-all">
                    <% if (errors.password) { %>
                    <p class="text-red-500 text-xs mt-1"><%= errors.password %></p>
                    <% } %>
                </div>

                <div class="mb-6">
                    <label class="block text-sm font-medium text-gray-600 mb-1">Confirm Password</label>
                    <input type="password" name="confirmPassword"
                           placeholder="Re-enter password"
                           class="w-full px-4 py-2.5 border border-gray-200 rounded-lg text-sm bg-gray-50 text-gray-800 transition-all">
                    <% if (errors.confirmPassword) { %>
                    <p class="text-red-500 text-xs mt-1"><%= errors.confirmPassword %></p>
                    <% } %>
                </div>

                <button type="submit"
                        class="btn w-full bg-indigo-600 hover:bg-indigo-700 text-white py-3 rounded-lg text-sm font-semibold transition-colors">
                    Register
                </button>

                <p class="text-center text-sm text-gray-400 mt-4">
                    <a href="/users" class="text-indigo-500 hover:text-indigo-700">View all registered users →</a>
                </p>
            </form>
        </div>
    </section>

    <!-- CONTACT -->



    <section id="contact" class="py-14 px-6 bg-gray-50">
        <div class="max-w-md mx-auto text-center">
            <h2 class="text-2xl font-bold text-gray-800 mb-3">Contact</h2>
            <p class="text-gray-500 text-sm mb-6">Reach out for any questions about this project.</p>
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                <div class="card bg-white border rounded-xl p-4">
                    <p class="text-xl mb-1">📧</p>
                    <p class="text-xs text-gray-500">xyz@gmail.com</p>
                </div>
                <div class="card bg-white border rounded-xl p-4">
                    <p class="text-xl mb-1">💻</p>
                    <p class="text-xs text-gray-500">github.com/abc</p>
                </div>
                <div class="card bg-white border rounded-xl p-4">
                    <p class="text-xl mb-1">🌐</p>
                    <p class="text-xs text-gray-500">xyz.com</p>
                </div>
            </div>
        </div>
    </section>

    <!-- FOOTER -->
    <footer class="bg-white border-t py-5 text-center text-sm text-gray-400">
        © 2025 Registration Form 
    </footer>

</body>
</html>
