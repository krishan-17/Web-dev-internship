<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Register</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="/style.css">
</head>
<body class="bg-gray-50 text-gray-700">

    <!-- HEADER   -->
    <header class="bg-white shadow-sm sticky top-0 z-10">
        <div class="max-w-5xl mx-auto px-6 py-4 flex justify-between items-center">
            <span class="text-lg font-bold text-indigo-600">Registration Form</span>
            <nav id="mainNav" class="hidden md:flex gap-6 text-sm font-medium text-gray-500">
                <a href="#about" data-route="about" class="nav-link hover:text-indigo-600">About</a>
                <a href="#services" data-route="services" class="nav-link hover:text-indigo-600">Services</a>
                <a href="#register" data-route="register" class="nav-link hover:text-indigo-600">Register</a>
                <a href="#contact" data-route="contact" class="nav-link hover:text-indigo-600">Contact</a>
                <a href="#users" data-route="users" class="nav-link hover:text-indigo-600">Users</a>
            </nav>
        </div>
    </header>


    <!-- About Section  -->


    <section id="about" data-section class="app-section py-14 px-6 bg-white">
        <div class="max-w-4xl mx-auto text-center">
            <h2 class="text-2xl font-bold text-gray-800 mb-3">About</h2>
            <p class="text-gray-500 text-sm max-w-xl mx-auto mb-8">
                It is a simple user registration system built with Node.js, EJS, and Tailwind CSS. It validates your data on both client and server side, with live feedback as you type.
            </p>
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-5">
                <div class="card border rounded-xl p-5">
                    <p class="text-2xl mb-2">🛡️</p>
                    <p class="font-semibold text-sm text-gray-800">Server Validation</p>
                    <p class="text-gray-400 text-xs mt-1">Validate user on the backend</p>
                </div>
                <div class="card border rounded-xl p-5">
                    <p class="text-2xl mb-2">⚡</p>
                    <p class="font-semibold text-sm text-gray-800">Live Client Validation</p>
                    <p class="text-gray-400 text-xs mt-1">Instant error feedback as you type</p>
                </div>
                <div class="card border rounded-xl p-5">
                    <p class="text-2xl mb-2">🧭</p>
                    <p class="font-semibold text-sm text-gray-800">SPA-style Routing</p>
                    <p class="text-gray-400 text-xs mt-1">Hash-based navigation, no reloads</p>
                </div>
            </div>
        </div>
    </section>

    <!-- SERVICES -->
    <section id="services" data-section class="app-section py-14 px-6 bg-gray-50">
        <div class="max-w-4xl mx-auto text-center">
            <h2 class="text-2xl font-bold text-gray-800 mb-3">Services</h2>
            <p class="text-gray-500 text-sm max-w-xl mx-auto mb-8">
                What this app provides in simple terms.
            </p>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-5 text-left">
                <div class="card bg-white border rounded-xl p-5">
                    <p class="font-semibold text-gray-800 mb-1">📝 User Registration</p>
                    <p class="text-gray-400 text-sm">Fill the form below to register yourself with username, email, age and password. Errors show up live as you type.</p>
                </div>
                <div class="card bg-white border rounded-xl p-5">
                    <p class="font-semibold text-gray-800 mb-1">📋 View Registered Users</p>
                    <p class="text-gray-400 text-sm">See all users who have registered in this session in a clean table, loaded without a page reload.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- REGISTER FORM -->
    <section id="register" data-section class="app-section py-14 px-6 bg-white">
        <div class="max-w-md mx-auto">
            <h2 class="text-2xl font-bold text-gray-800 text-center mb-1">Register</h2>
            <p class="text-center text-gray-400 text-sm mb-6">Fill in your details below</p>

            <!-- Dynamic success / error banner (filled in by script.js for AJAX submits) -->
            <div id="formBanner" class="hidden mb-5 rounded-xl p-4 text-sm text-center"></div>

            <% if (typeof success !== 'undefined' && success) { %>
            <div class="bg-green-50 border border-green-200 rounded-xl p-4 mb-5 text-sm text-green-700 text-center">
                ✅ <strong><%= registered.username %></strong> registered successfully!
                <a href="#users" data-route="users" class="nav-link underline ml-1 hover:text-green-900">View Users</a>
            </div>
            <% } %>

            <form id="registerForm" action="/#register" method="POST" novalidate>
                <div class="mb-4">
                    <label class="block text-sm font-medium text-gray-600 mb-1" for="username">Username</label>
                    <input type="text" id="username" name="username" value="<%= old.username || '' %>"
                           placeholder="e.g. john_doe" autocomplete="username"
                           class="field-input w-full px-4 py-2.5 border border-gray-200 rounded-lg text-sm bg-gray-50 text-gray-800 transition-all">
                    <p id="username-error" class="live-error text-red-500 text-xs mt-1 hidden"></p>
                    <% if (errors.username) { %>
                    <p class="text-red-500 text-xs mt-1"><%= errors.username %></p>
                    <% } %>
                </div>

                <div class="mb-4">
                    <label class="block text-sm font-medium text-gray-600 mb-1" for="email">Email</label>
                    <input type="email" id="email" name="email" value="<%= old.email || '' %>"
                           placeholder="you@example.com" autocomplete="email"
                           class="field-input w-full px-4 py-2.5 border border-gray-200 rounded-lg text-sm bg-gray-50 text-gray-800 transition-all">
                    <p id="email-error" class="live-error text-red-500 text-xs mt-1 hidden"></p>
                    <% if (errors.email) { %>
                    <p class="text-red-500 text-xs mt-1"><%= errors.email %></p>
                    <% } %>
                </div>

                <div class="mb-4">
                    <label class="block text-sm font-medium text-gray-600 mb-1" for="age">Age</label>
                    <input type="number" id="age" name="age" value="<%= old.age || '' %>"
                           placeholder="13 – 100"
                           class="field-input w-full px-4 py-2.5 border border-gray-200 rounded-lg text-sm bg-gray-50 text-gray-800 transition-all">
                    <p id="age-error" class="live-error text-red-500 text-xs mt-1 hidden"></p>
                    <% if (errors.age) { %>
                    <p class="text-red-500 text-xs mt-1"><%= errors.age %></p>
                    <% } %>
                </div>

                <div class="mb-4">
                    <label class="block text-sm font-medium text-gray-600 mb-1" for="password">Password</label>
                    <div class="relative">
                        <input type="password" id="password" name="password"
                               placeholder="Min. 6 characters" autocomplete="new-password"
                               class="field-input w-full px-4 py-2.5 pr-11 border border-gray-200 rounded-lg text-sm bg-gray-50 text-gray-800 transition-all">
                        <button type="button" data-toggle="password" class="toggle-password absolute right-3 top-1/2 -translate-y-1/2 text-gray-400 hover:text-indigo-600 text-sm" aria-label="Show password">👁</button>
                    </div>
                    <!-- Password strength (text only) -->
                    <p id="passwordStrengthText" class="text-xs mt-1.5 font-medium text-gray-400">&nbsp;</p>
                    <p id="password-error" class="live-error text-red-500 text-xs mt-1 hidden"></p>
                    <% if (errors.password) { %>
                    <p class="text-red-500 text-xs mt-1"><%= errors.password %></p>
                    <% } %>
                </div>

                <div class="mb-6">
                    <label class="block text-sm font-medium text-gray-600 mb-1" for="confirmPassword">Confirm Password</label>
                    <div class="relative">
                        <input type="password" id="confirmPassword" name="confirmPassword"
                               placeholder="Re-enter password" autocomplete="new-password"
                               class="field-input w-full px-4 py-2.5 pr-11 border border-gray-200 rounded-lg text-sm bg-gray-50 text-gray-800 transition-all">
                        <button type="button" data-toggle="confirmPassword" class="toggle-password absolute right-3 top-1/2 -translate-y-1/2 text-gray-400 hover:text-indigo-600 text-sm" aria-label="Show password">👁</button>
                    </div>
                    <p id="confirmPassword-error" class="live-error text-red-500 text-xs mt-1 hidden"></p>
                    <% if (errors.confirmPassword) { %>
                    <p class="text-red-500 text-xs mt-1"><%= errors.confirmPassword %></p>
                    <% } %>
                </div>

                <button type="submit" id="submitBtn"
                        class="btn w-full bg-indigo-600 hover:bg-indigo-700 text-white py-3 rounded-lg text-sm font-semibold transition-colors">
                    Register
                </button>

                <p class="text-center text-sm text-gray-400 mt-4">
                    <a href="#users" data-route="users" class="nav-link text-indigo-500 hover:text-indigo-700">View all registered users →</a>
                </p>
            </form>
        </div>
    </section>

    <!-- CONTACT -->



    <section id="contact" data-section class="app-section py-14 px-6 bg-gray-50">
        <div class="max-w-md mx-auto text-center">
            <h2 class="text-2xl font-bold text-gray-800 mb-3">Contact</h2>
            <p class="text-gray-500 text-sm mb-6">Reach out for any questions about this project.</p>
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                <div class="card bg-white border rounded-xl p-4">
                    <p class="text-xl mb-1">📧</p>
                    <p class="text-xs text-gray-500">xyz@gmail.com</p>
                </div>
                <div class="card bg-white border rounded-xl p-4">
                    <p class="text-xl mb-1">💻</p>
                    <p class="text-xs text-gray-500">github.com/abc</p>
                </div>
                <div class="card bg-white border rounded-xl p-4">
                    <p class="text-xl mb-1">🌐</p>
                    <p class="text-xs text-gray-500">xyz.com</p>
                </div>
            </div>
        </div>
    </section>

    <!-- USERS (loaded dynamically via /api/users, no page reload) -->
    <section id="users" data-section class="app-section py-14 px-6 bg-white">
        <div class="max-w-2xl mx-auto">
            <div class="flex justify-between items-center mb-6">
                <h2 class="text-xl font-bold text-gray-800">Registered Users</h2>
                <span id="usersCount" class="bg-indigo-100 text-indigo-600 text-xs font-semibold px-3 py-1 rounded-full">0 users</span>
            </div>
            <div id="usersContent">
                <p class="text-gray-400 text-sm text-center py-10">Loading users…</p>
            </div>
        </div>
    </section>

    <!-- FOOTER -->
    <footer class="bg-white border-t py-5 text-center text-sm text-gray-400">
        © 2025 Registration Form
    </footer>

    <script src="/script.js"></script>
</body>
</html>
