<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Registered Users</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="/style.css">
</head>
<body class="bg-gray-50 min-h-screen flex items-center justify-center py-10 px-4">

    <div class="bg-white w-full max-w-2xl rounded-xl shadow-sm border p-8">

        <div class="flex justify-between items-center mb-6">
            <h2 class="text-xl font-bold text-gray-800">Registered Users</h2>
            <span class="bg-indigo-100 text-indigo-600 text-xs font-semibold px-3 py-1 rounded-full">
                <%= users.length %> user<%= users.length !== 1 ? 's' : '' %>
            </span>
        </div>

        <% if (users.length === 0) { %>
        <div class="text-center py-10">
            <p class="text-gray-400 text-sm mb-4">No users registered yet.</p>
            <a href="/#register" class="bg-indigo-600 text-white px-5 py-2 rounded-lg text-sm btn">Register Now</a>
        </div>
        <% } else { %>
        <div class="overflow-x-auto rounded-lg border">
            <table class="w-full text-sm">
                <thead class="bg-indigo-600 text-white text-left">
                    <tr>
                        <th class="px-4 py-3 font-medium">ID</th>
                        <th class="px-4 py-3 font-medium">Username</th>
                        <th class="px-4 py-3 font-medium">Email</th>
                        <th class="px-4 py-3 font-medium">Age</th>
                    </tr>
                </thead>
                <tbody>
                    <% users.forEach(function(user, i) { %>
                    <tr class="border-t <%= i % 2 === 0 ? 'bg-white' : 'bg-gray-50' %> hover:bg-indigo-50">
                        <td class="px-4 py-3 text-gray-400">#<%= user.id %></td>
                        <td class="px-4 py-3 font-medium text-gray-800"><%= user.username %></td>
                        <td class="px-4 py-3 text-gray-500"><%= user.email %></td>
                        <td class="px-4 py-3 text-gray-600"><%= user.age %></td>
                    </tr>
                    <% }); %>
                </tbody>
            </table>
        </div>
        <% } %>

        <div class="mt-6">
            <a href="/" class="text-sm text-indigo-500 hover:text-indigo-700">← Back to Home</a>
        </div>
    </div>

</body>
</html>
